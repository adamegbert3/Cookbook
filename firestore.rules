rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // SECURITY FUNCTIONS
    // =========================================================

    // Keep the hardcoded list in sync with the ADMIN_UIDS arrays in
    // scripts/dashboard.js, scripts/main.js, scripts/profile.js,
    // scripts/review.js, and edit-recipe.html. These three are "built-in"
    // admins that always work even if the users/{uid} doc is ever deleted
    // or corrupted — everyone else is promoted live via the admin console's
    // "Manage Admin Access" widget, which just sets role:'admin' on their
    // users/{uid} doc (see the users/{userId} rules below for how that's
    // protected from self-promotion).
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          "n5aAU1g1tBY04Ut0HnhqegSgZe92", // Adam
          "NrY491PYN3MIrqJp4rhu5S86w2R2",
          "mPBrypCN9ab1LCEQ578E5YrX8DI2",
          "WxkJYdGYlIRs4FFdDdLcr05jUm22" // Austin
        ]
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'
        )
      );
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // --- GUEST MODE ---
    // Guests (people with a code but no account — see admin/guests.html)
    // sign in with Firebase ANONYMOUS AUTH instead of email/password. That
    // makes request.auth non-null, same as a real member, which is exactly
    // why isLoggedIn() alone is no longer enough to gate anything a guest
    // shouldn't reach: every `isLoggedIn()`-only rule below now ALSO needs
    // an explicit decision about whether an anonymous session should pass.
    //
    // isAnonymous() reads the AUTH TOKEN's sign_in_provider, not a Firestore
    // field. This matters: an earlier draft of this rule checked "does
    // users/{uid} have role:'guest'" instead, which sounds equivalent but
    // isn't — anyone can open devtools and call signInAnonymously() directly
    // without ever visiting guest.html, which never creates that users/{uid}
    // doc at all. Under the doc-based check that caller would have read as
    // "not a guest" and fallen through to full-member access, permanently,
    // for every recipe in the cookbook. Checking the token instead fails
    // CLOSED: a bare anonymous sign-in with no guest_codes doc behind it is
    // anonymous but not associated with any recipes, so guestAllowedRecipeIds()
    // below returns an empty list and every guest-gated read is denied.
    function isAnonymous() {
      return isLoggedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // A guest's users/{uid} doc (written by guest.html on first visit, using
    // the name the admin typed when creating the code — never typed by the
    // guest) carries which code they came in on. This looks that code up and
    // returns the specific recipe IDs the admin picked for it, or an empty
    // list if anything along the way is missing — a half-signed-up guest (no
    // users/{uid} doc yet) or a code that's been deactivated/deleted both
    // resolve to "can't read anything" rather than erroring.
    function guestAllowedRecipeIds() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let code = exists(userPath) ? get(userPath).data.get('guestCode', '') : '';
      let codePath = /databases/$(database)/documents/guest_codes/$(code);
      return (code != '' && exists(codePath)) ? get(codePath).data.get('recipeIds', []) : [];
    }

    // =========================================================
    // COLLECTION RULES
    //
    // Reads used to be public on `recipes`, `global_cooks`, `announcements`
    // and `static_assets`. That was a workaround: pages fired their first
    // Firestore read before Firebase Auth had finished restoring the
    // session, so requiring a login lost that race and the page failed to
    // load even for a signed-in user.
    //
    // That race is fixed — every read now happens after auth resolves
    // (loadAllRecipes runs inside onAuthStateChanged; recipePage.js awaits
    // its authReady promise and retries once on permission-denied;
    // print.js, leaderboard.js, profile.js and shopping-list.html all gate
    // on onAuthStateChanged). So these are now properly login-gated.
    //
    // ROLLBACK: if anything fails to load with "Missing or insufficient
    // permissions", set the four `read` rules below back to `if true` and
    // redeploy — that restores the previous, working-but-public behaviour.
    //
    // GUEST MODE, added later: enabling Anonymous Auth (see isAnonymous()
    // above) meant re-checking every one of these `isLoggedIn()`-only rules,
    // since an anonymous session now satisfies isLoggedIn() too. The rule
    // followed throughout: guests can CONSUME (read what's shared with them,
    // comment/favorite/cook it, same as a member) but not CONTRIBUTE (no
    // submitting, suggesting, or reporting) and can't see other families'
    // data (no households, no other members' cook history, no announcements,
    // no reading the sitewide recipe index). Anywhere it was unclear, the
    // answer chosen was to block the guest session, not allow it.
    // =========================================================

    // --- RECIPES (the shared, canonical copy everyone sees) ---
    match /recipes/{recipeId} {
      // Three ways in:
      //   1. A real member (logged in, not anonymous) — sees everything,
      //      same as always.
      //   2. A guest (anonymous) — sees ONLY the specific recipe IDs on
      //      their code, per guestAllowedRecipeIds() above.
      //   3. Anyone at all, no login required — ONLY if an admin has
      //      explicitly flipped `public: true` on this exact recipe (the
      //      printable QR recipe card feature, admin/recipe-list.html's
      //      "📇 Card" action). This is the one deliberately-public case in
      //      this whole file: it's opt-in per recipe, admin-only to set,
      //      and by design (so a printed card's QR code works for literally
      //      anyone who scans it, forever, with no code and no account).
      allow read: if (isLoggedIn() && !isAnonymous())
                  || (isAnonymous() && recipeId in guestAllowedRecipeIds())
                  || resource.data.get('public', false) == true;
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        // Same three-way split as the recipe itself, minus the public/QR
        // case — a stranger scanning a recipe card reads share.html, which
        // never touches comments at all, so there's no legitimate anonymous
        // caller here who ISN'T a guest with this recipe on their code.
        allow read, write: if isLoggedIn()
                           && (!isAnonymous() || recipeId in guestAllowedRecipeIds());
      }

      // Version history snapshots written before each admin edit. Guests
      // never need this — it's an editing/audit tool, not part of viewing
      // or cooking a recipe — so anonymous sessions are blocked outright
      // rather than scoped to their recipe list.
      match /history/{versionId} {
        allow read: if isLoggedIn() && !isAnonymous();
        allow create: if isAdmin();
      }
    }

    // --- SUBMISSION QUEUE ---
    // Guests consume the cookbook, they don't contribute to it — a guest
    // is a visitor Adam hasn't vetted as a family cook, so letting one
    // submit a new recipe (which lands in the same review queue as a real
    // member's submission) isn't wanted. Real members unaffected.
    match /pending_recipes/{docId} {
      allow create: if isLoggedIn() && !isAnonymous();
      allow read, write: if isAdmin();
    }

    // --- ISSUE REPORTS --- (same reasoning as pending_recipes above)
    match /recipe_reports/{reportId} {
      allow create: if isLoggedIn() && !isAnonymous();
      allow read, write: if isAdmin();
    }

    // --- SUGGESTED RECIPE FIXES ---
    // Anyone signed in (except a guest — same reasoning as pending_recipes
    // above) can propose a corrected version of a recipe from the recipe
    // page; only an admin can read the queue or act on it. Writers can't
    // read others' suggestions back, same as recipe_reports.
    match /recipe_suggestions/{suggestionId} {
      allow create: if isLoggedIn() && !isAnonymous();
      allow read, update, delete: if isAdmin();
    }

    // --- ANALYTICS: per-recipe views (admin dashboard only) ---
    // Signed-in only, so a stranger can't flood the Activity feed and the
    // view counts with fabricated entries. recipe.html already redirects
    // signed-out visitors, so nothing legitimate is affected.
    match /recipe_views/{viewId} {
      allow create: if isLoggedIn();
      allow read: if isAdmin();
      // Admins can re-attribute or clear historical records that were saved
      // before per-user tracking existed (see dashboard.js).
      allow update, delete: if isAdmin();
    }

    // --- ANALYTICS: site-wide daily visits (admin dashboard only) ---
    match /site_visits/{date} {
      allow create, update: if isLoggedIn();
      allow read: if isAdmin();
    }

    // --- ANALYTICS: per-person "visited the site today" log (feeds the
    // admin Activity roster, alongside recipe_views/global_cooks) ---
    match /site_visits_log/{logId} {
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      // Your own row, or an admin re-attributing an orphaned record.
      allow update: if isAdmin()
                    || (isLoggedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
      allow read: if isAdmin();
    }

    // --- LEADERBOARD / TOTAL MEALS COOKED ---
    // Was `read, write: if true`, meaning anyone on the internet — signed in
    // or not — could read, forge, overwrite or DELETE every cook record.
    // The leaderboard could have been wiped or stuffed by a stranger.
    // Now: you may only record a cook as yourself, and only delete your own
    // (which is what the "Undo" on I Made This does).
    //
    // GUEST MODE: `create` is deliberately left open to anonymous sessions
    // too — that's the ONLY way a guest's "I made this!" gets recorded
    // (recipePage.js's recordCook writes here as request.auth.uid, same
    // code path a member uses, no special-casing needed). `read` is now
    // real-members-only: this collection holds every real member's full
    // cook history, and a guest has no reason to browse who-cooked-what for
    // people outside their own visit — this was a genuine gap opened up the
    // moment Anonymous Auth got turned on (any isLoggedIn() reader, guest or
    // not, could previously read the whole collection).
    match /global_cooks/{docId} {
      allow read: if isLoggedIn() && !isAnonymous();
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // --- ANNOUNCEMENTS ---
    // Family-internal news — a guest here to look at a handful of shared
    // recipes has no reason to read announcements meant for the family.
    match /announcements/{docId} {
      allow read: if isLoggedIn() && !isAnonymous();
      allow write: if isAdmin();
    }

    // --- HOMEPAGE INDEX / STATIC ASSETS ---
    // This one doc holds every recipe name plus all their ingredients, so
    // leaving it public exposed the whole cookbook regardless of the
    // /recipes rule above. Same reasoning now blocks guests specifically:
    // guest.html never reads this doc (it fetches only the exact recipe IDs
    // on the guest's code, one at a time) — if a guest session ever DID
    // reach it (e.g. manually navigating to homepage.html), reading it would
    // leak the name + full ingredient list of every recipe in the whole
    // cookbook, not just the handful actually shared with them.
    match /static_assets/{docId} {
      allow read: if isLoggedIn() && !isAnonymous();
      allow write: if isAdmin();
    }

    // --- PASSWORD RESET REQUESTS ---
    // Someone who's forgotten their password is, by definition, signed out,
    // so `create` has to be open. Nothing sensitive is stored (an email
    // address they typed themselves) and no reset is actually sent until an
    // admin approves it, so the worst a stranger can do is put a junk row in
    // the admin's queue to dismiss.
    match /password_reset_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'status', 'requestedAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    // --- FAMILY MEMBER INVITES ---
    // Admin creates an invite doc (name/email/role, no password — accounts
    // are still created client-side via the normal, unprivileged
    // createUserWithEmailAndPassword call, never with admin credentials).
    // The invited person reads their own invite by its doc id (a link only
    // they were given) to self-serve their signup, then marks it used.
    // The document ID **is** the invite code, which makes the code itself
    // the secret and lets us split these two cases:
    //
    //   get  — anyone may read ONE invite, but only if they already know
    //          the code (you can't guess a random 8-character code).
    //   list — admins only. Previously this was `read: if true`, which
    //          also permits querying the whole collection, so anyone could
    //          enumerate every pending invite (names + emails) and claim
    //          one. Splitting get/list closes that.
    match /invites/{inviteCode} {
      allow create, delete: if isAdmin();
      allow get: if true;
      allow list: if isAdmin();
      // Only the person the invite was addressed to (matched by their
      // newly-created account's email) can mark it consumed.
      allow update: if request.auth != null
                    && request.auth.token.email == resource.data.email
                    && resource.data.used == false;
    }

    // --- GUEST CODES (admin/guests.html) ---
    // Same "the document ID IS the secret" shape as invites above, and for
    // the same reason: `get` (read ONE code you already know) has to be
    // open with no login at all, because guest.html reads this doc BEFORE
    // the guest has signed in anonymously (it needs the code to be valid
    // before bothering to create a session or a users/{uid} doc). `list`
    // stays admin-only so a stranger can't enumerate every guest code that
    // exists. Unlike invites, there's no guest-side `update` at all — a
    // guest never writes to their own guest_codes doc, only reads it once
    // to find their name + recipeIds (see guestAllowedRecipeIds() above).
    // Doc shape: { name, email, note, recipeIds: [...], active, createdAt,
    // createdBy, transferInviteCode }. `name`/`email` are always typed by
    // an admin at creation, never by the guest.
    match /guest_codes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- HOUSEHOLDS (shared weekly menu + shopping list) ---
    // A household is a couple or family who plan meals together. Members
    // share the weekly_plan and shopping list stored underneath it.
    //
    // Read is open to any signed-in REAL user on purpose: joining by code
    // requires querying households by their `code` field, which can't work
    // if you must already be a member to read. The documents hold nothing
    // sensitive (a name, a join code, and a list of uids), and knowing a
    // code is what grants entry — same as the invite links above.
    //
    // GUEST MODE: anonymous sessions are blocked outright on all of read/
    // create/update below. A guest has no legitimate reason to read another
    // family's join code, weekly plan, or shopping list — this was a real
    // gap opened up the moment Anonymous Auth got turned on, not something
    // that was already scoped correctly.
    match /households/{householdId} {
      allow read: if isLoggedIn() && !isAnonymous();
      allow create: if isLoggedIn() && !isAnonymous() && request.auth.uid in request.resource.data.members;
      // Members can update their own household; anyone signed in (except a
      // guest) may add THEMSELVES (that's joining by code) but not rewrite
      // the rest.
      allow update: if isLoggedIn() && !isAnonymous() && (
        request.auth.uid in resource.data.members
        || request.resource.data.members.hasOnly(resource.data.members.concat([request.auth.uid]))
        || isAdmin()
      );
      allow delete: if isAdmin();

      // Shared meal plan + shopping state — members only, guests never.
      match /{document=**} {
        allow read, write: if isLoggedIn() && !isAnonymous() && (
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members
          || isAdmin()
        );
      }
    }

    // --- USERS (profile, favorites, settings, weekly plan, private
    // notes, and personal recipe_overrides — everything under a user's
    // own uid, at any depth) ---
    match /users/{userId} {
      // Owners can always read their own doc; admins can read everyone's —
      // needed for the "Manage Admin Access" list on the admin console.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Creating your own doc (signup) is always allowed, but it can never
      // arrive already flagged admin=true — that would let anyone grant
      // themselves admin by calling the Auth SDK directly instead of going
      // through the invite/signup page. Becoming an admin only ever happens
      // as a separate step an existing admin takes afterward (see "update").
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.get('role', 'user') != 'admin';

      // Admins can update ANY user's doc (that's how promote/demote works).
      // Non-admins can update their own doc for everything EXCEPT their own
      // role field — otherwise anyone could self-promote with one write.
      allow update: if request.auth != null && (
        isAdmin()
        || (request.auth.uid == userId
            && request.resource.data.get('role', 'user') == resource.data.get('role', 'user'))
      );

      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
