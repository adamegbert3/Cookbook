rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // SECURITY FUNCTIONS
    // =========================================================

    // Keep this in sync with the ADMIN_UIDS arrays in scripts/dashboard.js,
    // scripts/main.js, scripts/profile.js, and edit-recipe.html.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        "n5aAU1g1tBY04Ut0HnhqegSgZe92",
        "NrY491PYN3MIrqJp4rhu5S86w2R2",
        "mPBrypCN9ab1LCEQ578E5YrX8DI2"
      ];
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // =========================================================
    // COLLECTION RULES
    //
    // Reads on `recipes`, `global_cooks`, `announcements`, and
    // `static_assets` are public (not gated on isLoggedIn()) on purpose:
    // pages fire their first Firestore read as soon as they load, often
    // before Firebase Auth has finished restoring the signed-in session
    // from storage. Requiring isLoggedIn() on those reads loses that race
    // and the page fails to load even for a logged-in user. The site's
    // own pages already redirect signed-out visitors away, so this isn't
    // opening anything the app doesn't already show to anyone with a link.
    // =========================================================

    // --- RECIPES (the shared, canonical copy everyone sees) ---
    match /recipes/{recipeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read, write: if isLoggedIn();
      }

      // Version history snapshots written before each admin edit
      match /history/{versionId} {
        allow read: if isLoggedIn();
        allow create: if isAdmin();
      }
    }

    // --- SUBMISSION QUEUE ---
    match /pending_recipes/{docId} {
      allow create: if isLoggedIn();
      allow read, write: if isAdmin();
    }

    // --- ISSUE REPORTS ---
    match /recipe_reports/{reportId} {
      allow create: if isLoggedIn();
      allow read, write: if isAdmin();
    }

    // --- ANALYTICS: per-recipe views (admin dashboard only) ---
    match /recipe_views/{viewId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // --- ANALYTICS: site-wide daily visits (admin dashboard only) ---
    match /site_visits/{date} {
      allow create, update: if isLoggedIn();
      allow read: if isAdmin();
    }

    // --- LEADERBOARD / TOTAL MEALS COOKED ---
    match /global_cooks/{docId} {
      allow read, write: if true;
    }

    // --- ANNOUNCEMENTS ---
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- HOMEPAGE INDEX / STATIC ASSETS ---
    match /static_assets/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- FAMILY MEMBER INVITES ---
    // Admin creates an invite doc (name/email/role, no password — accounts
    // are still created client-side via the normal, unprivileged
    // createUserWithEmailAndPassword call, never with admin credentials).
    // The invited person reads their own invite by its doc id (a link only
    // they were given) to self-serve their signup, then marks it used.
    match /invites/{inviteId} {
      allow create, delete: if isAdmin();
      allow read: if true;
      // Only the person the invite was actually addressed to (matched by
      // their newly-created account's email) can mark it consumed.
      allow update: if request.auth != null
                    && request.auth.token.email == resource.data.email
                    && resource.data.used == false;
    }

    // --- USERS (profile, favorites, settings, weekly plan, private
    // notes, and personal recipe_overrides — everything under a user's
    // own uid, at any depth) ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
