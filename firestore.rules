rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // SECURITY FUNCTIONS
    // =========================================================

    // Keep the hardcoded list in sync with the ADMIN_UIDS arrays in
    // scripts/dashboard.js, scripts/main.js, scripts/profile.js,
    // scripts/review.js, and edit-recipe.html. These three are "built-in"
    // admins that always work even if the users/{uid} doc is ever deleted
    // or corrupted — everyone else is promoted live via the admin console's
    // "Manage Admin Access" widget, which just sets role:'admin' on their
    // users/{uid} doc (see the users/{userId} rules below for how that's
    // protected from self-promotion).
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          "n5aAU1g1tBY04Ut0HnhqegSgZe92", // Adam
          "NrY491PYN3MIrqJp4rhu5S86w2R2",
          "mPBrypCN9ab1LCEQ578E5YrX8DI2",
          "WxkJYdGYlIRs4FFdDdLcr05jUm22" // Austin
        ]
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'
        )
      );
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // =========================================================
    // COLLECTION RULES
    //
    // Reads used to be public on `recipes`, `global_cooks`, `announcements`
    // and `static_assets`. That was a workaround: pages fired their first
    // Firestore read before Firebase Auth had finished restoring the
    // session, so requiring a login lost that race and the page failed to
    // load even for a signed-in user.
    //
    // That race is fixed — every read now happens after auth resolves
    // (loadAllRecipes runs inside onAuthStateChanged; recipePage.js awaits
    // its authReady promise and retries once on permission-denied;
    // print.js, leaderboard.js, profile.js and shopping-list.html all gate
    // on onAuthStateChanged). So these are now properly login-gated.
    //
    // ROLLBACK: if anything fails to load with "Missing or insufficient
    // permissions", set the four `read` rules below back to `if true` and
    // redeploy — that restores the previous, working-but-public behaviour.
    // =========================================================

    // --- RECIPES (the shared, canonical copy everyone sees) ---
    match /recipes/{recipeId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read, write: if isLoggedIn();
      }

      // Version history snapshots written before each admin edit
      match /history/{versionId} {
        allow read: if isLoggedIn();
        allow create: if isAdmin();
      }
    }

    // --- SUBMISSION QUEUE ---
    match /pending_recipes/{docId} {
      allow create: if isLoggedIn();
      allow read, write: if isAdmin();
    }

    // --- ISSUE REPORTS ---
    match /recipe_reports/{reportId} {
      allow create: if isLoggedIn();
      allow read, write: if isAdmin();
    }

    // --- SUGGESTED RECIPE FIXES ---
    // Anyone signed in can propose a corrected version of a recipe from the
    // recipe page; only an admin can read the queue or act on it. Writers
    // can't read others' suggestions back, same as recipe_reports.
    match /recipe_suggestions/{suggestionId} {
      allow create: if isLoggedIn();
      allow read, update, delete: if isAdmin();
    }

    // --- ANALYTICS: per-recipe views (admin dashboard only) ---
    // Signed-in only, so a stranger can't flood the Activity feed and the
    // view counts with fabricated entries. recipe.html already redirects
    // signed-out visitors, so nothing legitimate is affected.
    match /recipe_views/{viewId} {
      allow create: if isLoggedIn();
      allow read: if isAdmin();
      // Admins can re-attribute or clear historical records that were saved
      // before per-user tracking existed (see dashboard.js).
      allow update, delete: if isAdmin();
    }

    // --- ANALYTICS: site-wide daily visits (admin dashboard only) ---
    match /site_visits/{date} {
      allow create, update: if isLoggedIn();
      allow read: if isAdmin();
    }

    // --- ANALYTICS: per-person "visited the site today" log (feeds the
    // admin Activity roster, alongside recipe_views/global_cooks) ---
    match /site_visits_log/{logId} {
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      // Your own row, or an admin re-attributing an orphaned record.
      allow update: if isAdmin()
                    || (isLoggedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
      allow read: if isAdmin();
    }

    // --- LEADERBOARD / TOTAL MEALS COOKED ---
    // Was `read, write: if true`, meaning anyone on the internet — signed in
    // or not — could read, forge, overwrite or DELETE every cook record.
    // The leaderboard could have been wiped or stuffed by a stranger.
    // Now: you may only record a cook as yourself, and only delete your own
    // (which is what the "Undo" on I Made This does).
    match /global_cooks/{docId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // --- ANNOUNCEMENTS ---
    match /announcements/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // --- HOMEPAGE INDEX / STATIC ASSETS ---
    // This one doc holds every recipe name plus all their ingredients, so
    // leaving it public exposed the whole cookbook regardless of the
    // /recipes rule above.
    match /static_assets/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // --- PASSWORD RESET REQUESTS ---
    // Someone who's forgotten their password is, by definition, signed out,
    // so `create` has to be open. Nothing sensitive is stored (an email
    // address they typed themselves) and no reset is actually sent until an
    // admin approves it, so the worst a stranger can do is put a junk row in
    // the admin's queue to dismiss.
    match /password_reset_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'status', 'requestedAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    // --- FAMILY MEMBER INVITES ---
    // Admin creates an invite doc (name/email/role, no password — accounts
    // are still created client-side via the normal, unprivileged
    // createUserWithEmailAndPassword call, never with admin credentials).
    // The invited person reads their own invite by its doc id (a link only
    // they were given) to self-serve their signup, then marks it used.
    // The document ID **is** the invite code, which makes the code itself
    // the secret and lets us split these two cases:
    //
    //   get  — anyone may read ONE invite, but only if they already know
    //          the code (you can't guess a random 8-character code).
    //   list — admins only. Previously this was `read: if true`, which
    //          also permits querying the whole collection, so anyone could
    //          enumerate every pending invite (names + emails) and claim
    //          one. Splitting get/list closes that.
    match /invites/{inviteCode} {
      allow create, delete: if isAdmin();
      allow get: if true;
      allow list: if isAdmin();
      // Only the person the invite was addressed to (matched by their
      // newly-created account's email) can mark it consumed.
      allow update: if request.auth != null
                    && request.auth.token.email == resource.data.email
                    && resource.data.used == false;
    }

    // --- HOUSEHOLDS (shared weekly menu + shopping list) ---
    // A household is a couple or family who plan meals together. Members
    // share the weekly_plan and shopping list stored underneath it.
    //
    // Read is open to any signed-in user on purpose: joining by code
    // requires querying households by their `code` field, which can't work
    // if you must already be a member to read. The documents hold nothing
    // sensitive (a name, a join code, and a list of uids), and knowing a
    // code is what grants entry — same as the invite links above.
    match /households/{householdId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.auth.uid in request.resource.data.members;
      // Members can update their own household; anyone signed in may add
      // THEMSELVES (that's joining by code) but not rewrite the rest.
      allow update: if isLoggedIn() && (
        request.auth.uid in resource.data.members
        || request.resource.data.members.hasOnly(resource.data.members.concat([request.auth.uid]))
        || isAdmin()
      );
      allow delete: if isAdmin();

      // Shared meal plan + shopping state — members only.
      match /{document=**} {
        allow read, write: if isLoggedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members
          || isAdmin()
        );
      }
    }

    // --- USERS (profile, favorites, settings, weekly plan, private
    // notes, and personal recipe_overrides — everything under a user's
    // own uid, at any depth) ---
    match /users/{userId} {
      // Owners can always read their own doc; admins can read everyone's —
      // needed for the "Manage Admin Access" list on the admin console.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Creating your own doc (signup) is always allowed, but it can never
      // arrive already flagged admin=true — that would let anyone grant
      // themselves admin by calling the Auth SDK directly instead of going
      // through the invite/signup page. Becoming an admin only ever happens
      // as a separate step an existing admin takes afterward (see "update").
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.get('role', 'user') != 'admin';

      // Admins can update ANY user's doc (that's how promote/demote works).
      // Non-admins can update their own doc for everything EXCEPT their own
      // role field — otherwise anyone could self-promote with one write.
      allow update: if request.auth != null && (
        isAdmin()
        || (request.auth.uid == userId
            && request.resource.data.get('role', 'user') == resource.data.get('role', 'user'))
      );

      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
